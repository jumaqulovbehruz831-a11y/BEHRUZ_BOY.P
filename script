window.uploadFromGalereya = function(input) {
    const file = input.files[0];
    if (!file) return;

    // Rasm va videolar uchun hajmni biroz oshiramiz (2MB)
    if (file.size > 2 * 1024 * 1024) {
        alert("Fayl hajmi 2MB dan oshmasligi kerak!");
        input.value = "";
        return;
    }

    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onloadend = () => {
        if (file.type.startsWith('image/')) {
            sendToFirebase("LOCAL_IMG:" + reader.result);
        } else if (file.type.startsWith('video/')) {
            sendToFirebase("LOCAL_VID:" + reader.result);
        }
        input.value = "";
    };
};
